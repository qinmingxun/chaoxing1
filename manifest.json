{
  "manifest_version": 3,
  "name": "刷课助手",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.zhihuishu.com/*",
        "*://*.unipus.cn/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content/loader.js"]
    }
  ],
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "*://*.chaoxing.com/*",
    "*://*.zhihuishu.com/*",
    "*://*.unipus.cn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/md5.js",
        "lib/typr.js",
        "lib/table.json",
        "content/quiz-solver.js",
        "content/keep-alive.js",
        "content/video-manager.js",
        "content/adapters/chaoxing.js",
        "content/adapters/zhihuishu.js",
        "content/adapters/unipus.js"
      ],
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.zhihuishu.com/*",
        "*://*.unipus.cn/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
